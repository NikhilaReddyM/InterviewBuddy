# Copy this file to backend/.env (ignored by Git).
# Obtain a key at https://console.groq.com/keys and paste it locally, never into chat.
GROQ_API_KEY=
# Selected starting model; alternative: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

NEBIUS_API_KEY=
# Nebius evaluator only; use an available text-generation model.
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Public employer boards for broader discovery (no API keys required).
# Comma-separated job-board slugs; at most six per provider. Empty disables that provider.
GREENHOUSE_BOARDS=datadog,mongodb,cloudflare
ASHBY_BOARDS=ramp,notion
